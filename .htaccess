Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# Block direct access to private storage (must come first)
RewriteRule ^private/ - [F,L]

# Clean download URLs so mobile browsers save the file with the correct .gif name
# /download/{jobId}/{filename}.gif -> api.php?action=download&job={jobId}
# Job IDs are 32-character hex strings, filenames can contain various characters
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^download/([a-f0-9]{32})/(.+\.gif)$ api.php?action=download&job=$1 [L,QSA]

# Route API requests
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/?$ api.php [L,QSA]

# Catch-all for SPA routing (if needed)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]
</IfModule>
