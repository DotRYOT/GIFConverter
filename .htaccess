Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# Set the base directory if you're in a subdirectory
# Uncomment and adjust if your project is in a subdirectory like /gifconverter/
# RewriteBase /gifconverter/

# Route API requests
RewriteRule ^api/?$ api.php [L,QSA]

# Clean download URLs so mobile browsers save the file with the correct .gif name
# /download/{jobId}/{filename}.gif -> api.php?action=download&job={jobId}
# Job IDs are 32-character hex strings, filenames can contain various characters
RewriteCond %{REQUEST_URI} /download/[a-f0-9]{32}/
RewriteRule ^download/([a-f0-9]{32})/(.+)$ api.php?action=download&job=$1 [L,QSA]

# Block direct access to private storage
RewriteRule ^private/ - [F,L]
</IfModule>
